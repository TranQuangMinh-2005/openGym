  <diagram name="6. Designer" id="32063024">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="⑥ Designer: đề xuất thay đổi kế hoạch" style="text;html=1;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1F2622;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Agent duy nhất được đề xuất sửa kế hoạch (tránh nhiều agent cùng ghi gây mâu thuẫn); chỉ tạo đề xuất, không tự áp dụng" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="74" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Đầu vào&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Kế hoạch hiện tại&lt;br&gt;• Danh sách điều kiện + vi phạm&lt;br&gt;• Hồ sơ, thư viện bài tập (lọc theo thiết bị)&lt;br&gt;• Gợi ý từ Analyst&lt;br&gt;• Yêu cầu của người dùng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F4;strokeColor=#C9CEC6;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Dựng prompt&lt;/b&gt;&lt;br&gt;prompt tạo/sửa kế hoạch có sẵn + khối điều kiện" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;GPT-4o mini&lt;/b&gt;&lt;br&gt;trả danh sách thay đổi theo schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F6B55;strokeColor=#2F6B55;fontColor=#FFFFFF;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Ghép vào kế hoạch&lt;/b&gt;&lt;br&gt;áp thử danh sách thay đổi lên bản nháp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="810" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Gửi Verifier&lt;/b&gt;&lt;br&gt;lỗi → nhận lỗi cụ thể, sửa tối đa 1 lần" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;Đầu ra: đề xuất chờ duyệt&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;{&lt;br&gt;&amp;nbsp;changes: [{type: &quot;replace&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;day: &quot;B&quot;, from: &quot;back-squat&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;to: &quot;leg-press&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;reason: &quot;…&quot;}],&lt;br&gt;&amp;nbsp;satisfies: [&quot;c3&quot;, &quot;c4&quot;],&lt;br&gt;&amp;nbsp;onlyFutureSessions: true&lt;br&gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F4;strokeColor=#C9CEC6;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="110" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Vì sao chỉ một agent được sửa?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Theo Cognition: nhiều agent cùng ghi dễ tạo các phần mâu thuẫn. Các agent khác chỉ đọc hoặc gợi ý; mọi thay đổi đi qua một chỗ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;Dùng lại gì có sẵn?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prompt tạo/sửa kế hoạch, schema, cơ chế áp/hoàn tác đề xuất và vòng sửa lỗi một lần đã có trong mã nguồn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;Ví dụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Điều kiện mới 45 phút/buổi → bỏ 1 bài phụ và giảm 1 hiệp ở buổi B, giữ bài chính; mỗi thay đổi kèm lý do." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;Đánh giá&lt;/b&gt;&lt;br&gt;&lt;br&gt;So với phương án một lần gọi: tỷ lệ đề xuất hợp lệ, tỷ lệ vi phạm điều kiện, số lần phải sửa lại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Chú thích&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="LLM (GPT-4o mini)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F6B55;strokeColor=#2F6B55;fontColor=#FFFFFF;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="130" y="690" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="Code (xác định, test được)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="690" width="190" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="Dữ liệu" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#5A635E;fontColor=#1F2622;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="684" width="90" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="707" as="sourcePoint" />
            <mxPoint x="690" y="707" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c23" value="Luồng chính" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="700" y="690" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="830" y="707" as="sourcePoint" />
            <mxPoint x="890" y="707" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c25" value="Luồng phụ / gợi ý" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="900" y="690" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B5523B;strokeWidth=1.5;dashed=1;fontColor=#B5523B;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1070" y="707" as="sourcePoint" />
            <mxPoint x="1130" y="707" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c27" value="Lỗi / sửa lại" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1140" y="690" width="120" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="7. Verifier" id="75015101">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="⑦ Verifier: dãy bộ kiểm tra bằng code trước khi tới người dùng" style="text;html=1;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1F2622;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Theo LLM-Modulo: LLM chỉ đưa phương án, bộ kiểm tra bên ngoài mới quyết định. Lỗi được trả lại agent tạo ra nó, sửa tối đa 1 lần" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="74" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Đầu vào&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Đầu ra của Designer / Explainer / Analyst&lt;br&gt;• Danh sách điều kiện&lt;br&gt;• Các đoạn kiến thức đã tìm&lt;br&gt;• Bảng chỉ số của Analyst&lt;br&gt;• Cờ an toàn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F4;strokeColor=#C9CEC6;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Hợp lệ&lt;/b&gt;&lt;br&gt;bài tập tồn tại, đúng thiết bị, số buổi, mức tạ hợp lý (validate.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Điều kiện&lt;/b&gt;&lt;br&gt;chạy CHECKS[type] của từng điều kiện; chỉ sửa buổi chưa tập" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Nguồn và con số&lt;/b&gt;&lt;br&gt;[id] ∈ đoạn đã tìm; số trong lời ∈ bảng chỉ số" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="810" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;An toàn&lt;/b&gt;&lt;br&gt;chạy lại Safety Gate trên câu trả lời; tôn trọng cờ vàng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;Đầu ra&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;{&lt;br&gt;&amp;nbsp;ok: false,&lt;br&gt;&amp;nbsp;attempt: 1,&lt;br&gt;&amp;nbsp;errors: [{&lt;br&gt;&amp;nbsp;&amp;nbsp;critic: &quot;ledger&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;msg: &quot;Buổi B 52 phút &amp;gt; c3 (45)&quot;&lt;br&gt;&amp;nbsp;}]&lt;br&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;đạt → phản hồi / đề xuất chờ duyệt&lt;br&gt;sai lần 1 → trả lỗi về agent tạo ra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F4;strokeColor=#C9CEC6;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="110" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Vì sao kiểm tra bằng code?&lt;/b&gt;&lt;br&gt;&lt;br&gt;LLM tự chấm mình không đáng tin (Kambhampati, ICML 2024). Thiếu kiểm tra là một trong 3 nhóm lỗi chính của hệ đa agent (MAST, NeurIPS 2025)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;Vì sao chỉ sửa 1 lần?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Giới hạn chi phí và thời gian chờ. Sai hai lần là vấn đề của model, lặp tiếp chỉ tốn tiền; cách này đã có sẵn trong pipeline hiện tại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;Ví dụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Designer giữ buổi B 52 phút → lỗi &quot;vượt c3 (45)&quot; → Designer bỏ thêm 1 hiệp → 44 phút → đạt → đề xuất chờ duyệt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;Đánh giá&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ablation: tắt Verifier (--no-verifier) để đo nó giảm bao nhiêu vi phạm và trích nguồn sai." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Sai lần 2&lt;/b&gt;&lt;br&gt;không đạt: giữ kế hoạch cũ, báo lý do" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B5523B;strokeWidth=2;fontColor=#B5523B;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1300" y="330" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="sai lần 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B5523B;strokeWidth=1.5;dashed=1;fontColor=#B5523B;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;b&gt;Chú thích&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="90" height="30" as="geometry" />
