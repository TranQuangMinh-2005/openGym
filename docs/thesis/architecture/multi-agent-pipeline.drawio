  <diagram name="3. Ledger" id="11052132">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="③ Ledger: bộ nhớ điều kiện của người dùng" style="text;html=1;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1F2622;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Code thuần: nhận điều kiện đã tách từ Router hoặc người dùng sửa tay, lưu có lịch sử, mỗi kiểu điều kiện có hàm kiểm tra riêng" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="74" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Đầu vào&lt;/b&gt;&lt;br&gt;&lt;br&gt;• constraints từ Router&lt;br&gt;• Hồ sơ ban đầu (mục tiêu, số buổi, thiết bị, chấn thương)&lt;br&gt;• Người dùng sửa tay trên giao diện" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F4;strokeColor=#C9CEC6;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Chuẩn hóa kiểu&lt;/b&gt;&lt;br&gt;daysPerWeek · maxSessionMinutes · equipment · avoidExercise · injuryNote · preference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Xử lý xung đột&lt;/b&gt;&lt;br&gt;cùng kiểu → bản mới thay bản cũ, giữ lịch sử" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Lưu ledger&lt;/b&gt;&lt;br&gt;vào state người dùng, đánh số phiên bản" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="810" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Kiểm kế hoạch hiện tại&lt;/b&gt;&lt;br&gt;CHECKS[type](plan) → có vi phạm thì cần lập lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;Đầu ra&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;ledger: [{&lt;br&gt;&amp;nbsp;id: &quot;c3&quot;,&lt;br&gt;&amp;nbsp;type: &quot;maxSessionMinutes&quot;,&lt;br&gt;&amp;nbsp;value: 45,&lt;br&gt;&amp;nbsp;source: &quot;chat&quot;,&lt;br&gt;&amp;nbsp;createdAt, active,&lt;br&gt;&amp;nbsp;supersedes: &quot;c1&quot;&lt;br&gt;}],&lt;br&gt;needsReplan: true,&lt;br&gt;violations: [&quot;Buổi B: 62 phút&quot;]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F4;strokeColor=#C9CEC6;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="110" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Vì sao tách thành agent riêng?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lỗi phổ biến nhất của chatbot là quên điều kiện sau vài lượt. Ledger biến điều kiện thành dữ liệu có cấu trúc, không phụ thuộc trí nhớ hội thoại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;Vì sao mỗi kiểu có hàm kiểm tra?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Số vi phạm được đếm bằng code nên chỉ số &quot;tỷ lệ vi phạm điều kiện&quot; trong đánh giá đáng tin. Kiểu tự do (preference) mới cần LLM xét." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;Người dùng thấy gì?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Một danh sách điều kiện hiển thị trên giao diện, sửa/xóa được. Minh bạch: biết AI đang nhớ gì." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;Ví dụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hồ sơ: 60 phút/buổi (c1). Chat: &quot;giờ chỉ còn 45 phút&quot; → c3 thay c1 → buổi B dài 62 phút vi phạm → needsReplan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Chú thích&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="LLM (GPT-4o mini)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F6B55;strokeColor=#2F6B55;fontColor=#FFFFFF;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="130" y="690" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="Code (xác định, test được)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="690" width="190" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="Dữ liệu" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#5A635E;fontColor=#1F2622;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="684" width="90" height="46" as="geometry" />
        </mxCell>
