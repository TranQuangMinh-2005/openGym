  <diagram name="8. Bộ nhớ chung" id="92106289">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="Bộ nhớ chung: ai đọc, ai ghi" style="text;html=1;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1F2622;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Một nguồn dữ liệu chung để không agent nào mất ngữ cảnh; quyền ghi được giới hạn rõ cho từng agent" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="74" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;table border=&quot;1&quot; cellpadding=&quot;8&quot; style=&quot;border-collapse:collapse;border-color:#C9CEC6;font-size:13px;&quot;&gt;&lt;tr style=&quot;background:#2F6B55;color:#FFFFFF;&quot;&gt;&lt;th&gt;Dữ liệu&lt;/th&gt;&lt;th&gt;Safety&lt;/th&gt;&lt;th&gt;Router&lt;/th&gt;&lt;th&gt;Ledger&lt;/th&gt;&lt;th&gt;Explainer&lt;/th&gt;&lt;th&gt;Analyst&lt;/th&gt;&lt;th&gt;Designer&lt;/th&gt;&lt;th&gt;Verifier&lt;/th&gt;&lt;th&gt;Người dùng&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Hội thoại gần đây&lt;/b&gt; (ngắn hạn)&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;ghi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Hồ sơ&lt;/b&gt;&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;ghi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Danh sách điều kiện&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;&lt;b&gt;ghi&lt;/b&gt;&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;sửa tay&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Nhật ký tập&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;ghi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Phiên bản kế hoạch&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;&lt;b&gt;đề xuất&lt;/b&gt;&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;&lt;b&gt;duyệt → ghi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Kho kiến thức&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;đọc&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Trace&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ghi&lt;/td&gt;&lt;td&gt;ghi&lt;/td&gt;&lt;td&gt;ghi&lt;/td&gt;&lt;td&gt;ghi&lt;/td&gt;&lt;td&gt;ghi&lt;/td&gt;&lt;td&gt;ghi&lt;/td&gt;&lt;td&gt;ghi&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="1200" height="330" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Nguyên tắc&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Chỉ Ledger ghi danh sách điều kiện.&lt;br&gt;• Chỉ Designer tạo đề xuất kế hoạch; chỉ người dùng duyệt mới thành phiên bản mới.&lt;br&gt;• Phiên bản mới chỉ thay các buổi chưa tập, nhật ký cũ giữ nguyên, hoàn tác được.&lt;br&gt;• Mọi agent ghi trace để chạy lại và đánh giá." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="140" width="480" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Lưu ở đâu&lt;/b&gt;&lt;br&gt;&lt;br&gt;File state của từng người dùng (JSON, ghi nguyên tử) thêm 3 khóa: coach.ledger, coach.versions, coach.chat. Kho kiến thức là file chunks.json đi kèm mã nguồn. Trace là file JSONL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="380" width="480" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
