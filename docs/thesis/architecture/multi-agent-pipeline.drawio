  <diagram name="4. Explainer" id="75327803">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="④ Explainer: giải thích &quot;vì sao&quot; có trích nguồn (RAG)" style="text;html=1;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1F2622;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Chỉ trả lời dựa trên các đoạn kiến thức tìm được; không đủ căn cứ thì nói rõ là không đủ, không bịa" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="74" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Đầu vào&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Câu hỏi&lt;br&gt;• Bài tập / buổi được hỏi&lt;br&gt;• Mục tiêu, trình độ, điều kiện&lt;br&gt;• Kho kiến thức ~150 đoạn {id, tiêu đề, nội dung, nguồn}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F4;strokeColor=#C9CEC6;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Tạo truy vấn&lt;/b&gt;&lt;br&gt;câu hỏi + tên bài + mục tiêu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Tìm BM25&lt;/b&gt;&lt;br&gt;lấy 5 đoạn điểm cao nhất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Đủ căn cứ?&lt;/b&gt;&lt;br&gt;điểm thấp → trả &quot;chưa đủ căn cứ trong kho&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="810" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;GPT-4o mini trả lời&lt;/b&gt;&lt;br&gt;chỉ dùng các đoạn được đưa, mỗi ý gắn [id]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F6B55;strokeColor=#2F6B55;fontColor=#FFFFFF;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;Đầu ra&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;{&lt;br&gt;&amp;nbsp;answer: &quot;Romanian deadlift tập&lt;br&gt;&amp;nbsp;&amp;nbsp;nhóm cơ đùi sau… [k12]&quot;,&lt;br&gt;&amp;nbsp;citations: [&quot;k12&quot;, &quot;k40&quot;],&lt;br&gt;&amp;nbsp;retrieved: [&quot;k12&quot;,&quot;k40&quot;,&quot;k7&quot;,…]&lt;br&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;Verifier: citations ⊆ retrieved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F4;strokeColor=#C9CEC6;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="110" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Vì sao BM25 chứ không vector DB?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Kho nhỏ (~150 đoạn), BM25 tự viết khoảng 60 dòng, không thêm thư viện, kết quả giải thích được. Có thể so với embedding trong phần đánh giá." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;Chống bịa nguồn thế nào?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mỗi đoạn có id. Verifier kiểm mọi [id] trong câu trả lời phải nằm trong 5 đoạn đã đưa; sai → tính lỗi, sửa lại 1 lần." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;Ví dụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;&quot;Vì sao có bài RDL ở buổi A?&quot; → tìm k12 (RDL, đùi sau), k40 (cân bằng trước/sau) → trả lời 3 câu, kèm 2 nguồn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;Đánh giá&lt;/b&gt;&lt;br&gt;&lt;br&gt;Độ chính xác trích dẫn (tính bằng code) + chất lượng giải thích (model chấm khác + người chấm lại 20%)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Chú thích&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="LLM (GPT-4o mini)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F6B55;strokeColor=#2F6B55;fontColor=#FFFFFF;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="130" y="690" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="Code (xác định, test được)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="690" width="190" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="Dữ liệu" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#5A635E;fontColor=#1F2622;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="684" width="90" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="707" as="sourcePoint" />
            <mxPoint x="690" y="707" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c23" value="Luồng chính" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="700" y="690" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="830" y="707" as="sourcePoint" />
            <mxPoint x="890" y="707" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c25" value="Luồng phụ / gợi ý" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="900" y="690" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B5523B;strokeWidth=1.5;dashed=1;fontColor=#B5523B;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1070" y="707" as="sourcePoint" />
            <mxPoint x="1130" y="707" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c27" value="Lỗi / sửa lại" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1140" y="690" width="120" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5. Analyst" id="30647820">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="⑤ Analyst: đọc nhật ký tập, code tính và LLM diễn giải" style="text;html=1;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1F2622;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Mọi con số do code tính; LLM chỉ diễn giải và không được tạo ra số mới" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="74" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Đầu vào&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Nhật ký tập: bài, hiệp, reps, mức tạ, mức gắng sức&lt;br&gt;• Kế hoạch hiện tại&lt;br&gt;• Danh sách điều kiện&lt;br&gt;• Khoảng thời gian được hỏi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F4;strokeColor=#C9CEC6;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Tính chỉ số&lt;/b&gt;&lt;br&gt;1RM ước tính · số buổi chững tạ · tỷ lệ hoàn thành · khối lượng/nhóm cơ/tuần" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Phát hiện xu hướng&lt;/b&gt;&lt;br&gt;tăng · đứng · giảm; dấu hiệu cần deload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;GPT-4o mini diễn giải&lt;/b&gt;&lt;br&gt;nhận bảng số, viết nhận xét dễ hiểu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F6B55;strokeColor=#2F6B55;fontColor=#FFFFFF;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="810" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Gợi ý&lt;/b&gt;&lt;br&gt;nếu cần đổi lịch → chuyển cho Designer (người dùng đồng ý)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;Đầu ra&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;{&lt;br&gt;&amp;nbsp;metrics: {squat: {e1rm: [80,82,82,82],&lt;br&gt;&amp;nbsp;&amp;nbsp;stall: 3}, adherence: 0.75},&lt;br&gt;&amp;nbsp;findings: [{type: &quot;stall&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;exercise: &quot;squat&quot;, weeks: 3}],&lt;br&gt;&amp;nbsp;narrative: &quot;…&quot;,&lt;br&gt;&amp;nbsp;suggestions: [&quot;deload 10%&quot;]&lt;br&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;Verifier: số trong narrative ∈ metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F4;strokeColor=#C9CEC6;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="110" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Vì sao code tính, LLM diễn giải?&lt;/b&gt;&lt;br&gt;&lt;br&gt;LLM nhỏ hay tính sai và bịa số. Code dùng lại các hàm có sẵn và đã test (1RM, đếm chững tạ); LLM chỉ làm phần ngôn ngữ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;Tương ứng nghiên cứu&lt;/b&gt;&lt;br&gt;&lt;br&gt;Giống agent &quot;data science&quot; trong Personal Health Agent (Google, 2025): tách phân tích dữ liệu khỏi phần huấn luyện." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;Ví dụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;&quot;Sao squat mãi không lên?&quot; → chững 3 tuần ở 82 kg, hoàn thành 75% buổi → gợi ý deload 10% rồi tăng lại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;Đánh giá&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tỷ lệ con số đúng (so với metrics) và nhận xét có khớp dữ liệu không." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Chú thích&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="LLM (GPT-4o mini)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F6B55;strokeColor=#2F6B55;fontColor=#FFFFFF;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="130" y="690" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="Code (xác định, test được)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="690" width="190" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="Dữ liệu" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#5A635E;fontColor=#1F2622;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="684" width="90" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
