  <diagram name="2. Router" id="48797958">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="② Router: hiểu người dùng muốn gì và tách điều kiện mới" style="text;html=1;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1F2622;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Một lần gọi GPT-4o mini với JSON schema cố định; có luật dự phòng bằng từ khóa nếu model trả sai" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="74" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Đầu vào&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Tin nhắn hiện tại&lt;br&gt;• 6 tin gần nhất&lt;br&gt;• Tóm tắt danh sách điều kiện&lt;br&gt;• Cờ từ Safety Gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F4;strokeColor=#C9CEC6;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Dựng prompt&lt;/b&gt;&lt;br&gt;mô tả 5 loại ý định + các kiểu điều kiện hợp lệ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Gọi GPT-4o mini&lt;/b&gt;&lt;br&gt;structured output theo schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F6B55;strokeColor=#2F6B55;fontColor=#FFFFFF;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Kiểm tra schema&lt;/b&gt;&lt;br&gt;sai → luật từ khóa dự phòng (&quot;vì sao&quot; → explain…)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="810" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Độ tin cậy&lt;/b&gt;&lt;br&gt;&amp;lt; 0.6 → hỏi lại 1 câu làm rõ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;Đầu ra&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;{&lt;br&gt;&amp;nbsp;intent: &quot;explain&quot; | &quot;change_plan&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;| &quot;update_constraint&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;| &quot;progress&quot; | &quot;other&quot;,&lt;br&gt;&amp;nbsp;constraints: [{type, value,&lt;br&gt;&amp;nbsp;&amp;nbsp;evidence}],&lt;br&gt;&amp;nbsp;target: {exerciseId?, day?},&lt;br&gt;&amp;nbsp;confidence: 0.0–1.0&lt;br&gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F4;strokeColor=#C9CEC6;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="110" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Vì sao cần Router?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mỗi loại câu hỏi cần ngữ cảnh và kiểm tra khác nhau. Gửi đúng chỗ giúp prompt ngắn, rẻ, ít lỗi hơn một prompt làm tất cả (mẫu Routing, Anthropic)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;Một câu nhiều ý?&lt;/b&gt;&lt;br&gt;&lt;br&gt;&quot;Tuần này chỉ tập được 3 buổi, sao lại có deadlift?&quot; → intent chính change_plan, kèm constraint daysPerWeek = 3; câu hỏi phụ được trả lời sau." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;Ví dụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;&quot;Mình chỉ còn 45 phút mỗi buổi&quot; → update_constraint, {type: maxSessionMinutes, value: 45, evidence: &quot;chỉ còn 45 phút&quot;}." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;Đánh giá&lt;/b&gt;&lt;br&gt;&lt;br&gt;Độ chính xác phân loại ý định và độ đầy đủ khi tách điều kiện, so với nhãn của bộ test." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Chú thích&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="LLM (GPT-4o mini)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F6B55;strokeColor=#2F6B55;fontColor=#FFFFFF;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="130" y="690" width="150" height="34" as="geometry" />
