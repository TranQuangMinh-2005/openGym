  <diagram name="1. Safety Gate" id="41474391">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="① Safety Gate: chặn dấu hiệu nguy hiểm trước khi gọi bất kỳ LLM nào" style="text;html=1;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1F2622;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Code thuần, chạy đầu tiên cho mọi tin nhắn và ghi chú buổi tập; chạy lại trong Verifier cho câu trả lời đầu ra" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5A635E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="74" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Đầu vào&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Tin nhắn người dùng&lt;br&gt;• Ghi chú cuối buổi tập&lt;br&gt;• Ghi chú chấn thương trong hồ sơ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F4;strokeColor=#C9CEC6;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Chuẩn hóa văn bản&lt;/b&gt;&lt;br&gt;chữ thường, bỏ dấu, tách từ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;So khớp mẫu&lt;/b&gt;&lt;br&gt;đau ngực, khó thở, chóng mặt, ngất, tê lan, đau nhói khớp, nghi chấn thương…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Phân mức&lt;/b&gt;&lt;br&gt;đỏ · vàng · xanh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="810" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Rẽ nhánh&lt;/b&gt;&lt;br&gt;đỏ → dừng ngay&lt;br&gt;vàng → đi tiếp, gắn cờ&lt;br&gt;xanh → đi tiếp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6B55;strokeWidth=2;fontColor=#1F2622;fontSize=13;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="150" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;Đầu ra&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;{&lt;br&gt;&amp;nbsp;level: &quot;red&quot; | &quot;amber&quot; | &quot;green&quot;,&lt;br&gt;&amp;nbsp;matched: [&quot;đau nhói vai&quot;],&lt;br&gt;&amp;nbsp;message?: &quot;…&quot;&lt;br&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;đỏ: trả thông điệp an toàn cố định, không gọi LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F4;strokeColor=#C9CEC6;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="110" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A635E;strokeWidth=2;fontColor=#1F2622;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Vì sao dùng code, không dùng LLM?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Xác định, test được bằng unit test, không bị bỏ sót do model &quot;quên&quot;. Đánh đổi: có thể chặn nhầm, nên mức vàng chỉ gắn cờ chứ không dừng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;Cờ vàng ảnh hưởng gì?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Router nhận cờ. Designer không được tăng tải bài liên quan vùng đau. Verifier kiểm tra lại điều này." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;Ví dụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;&quot;Squat xong đau nhói gối phải&quot; → đỏ: dừng, khuyên gặp bác sĩ/chuyên viên vật lý trị liệu, không gợi ý bài thay thế." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="420" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;Đánh giá&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nhóm tình huống an toàn trong bộ test: đo tỷ lệ chặn đúng và tỷ lệ chặn nhầm." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EFEA;strokeColor=none;fontColor=#1F2622;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
