<mxfile host="drawio"><diagram id="erd" name="ERD"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="gconv" value="Hội thoại &amp; agent" style="rounded=1;arcSize=2;html=1;fillColor=#fff4e5;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=15;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="18" y="108" width="684" height="572" as="geometry"/></mxCell><mxCell id="guser" value="Người dùng" style="rounded=1;arcSize=2;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=15;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="818" y="108" width="684" height="572" as="geometry"/></mxCell><mxCell id="gplan" value="Chương trình &amp; nhật ký" style="rounded=1;arcSize=2;html=1;fillColor=#eef7ec;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=15;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="18" y="758" width="1484" height="380" as="geometry"/></mxCell><mxCell id="gknow" value="Kho kiến thức (thư viện bài + tài liệu)" style="rounded=1;arcSize=2;html=1;fillColor=#f4eef7;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=15;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="18" y="1206" width="1114" height="418" as="geometry"/></mxCell><mxCell id="ttl" value="ERD – Trợ lý AI đa agent trên openGym" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="18" y="8" width="800" height="34" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;PK&lt;/b&gt; khóa chính · &lt;b&gt;FK&lt;/b&gt; khóa ngoại · kiểu in nghiêng · viền nét đứt = có sẵn trong openGym, nét liền = mới · &lt;font color=&quot;#b85450&quot;&gt;chữ đỏ&lt;/font&gt; = cột mới · chân chim = quan hệ · cung nhảy = hai đường cắt nhau" style="text;html=1;fontSize=